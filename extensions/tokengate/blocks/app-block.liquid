<div
  id="tokengating-example-app"
  data-product_id="{{ product.id }}"
  data-product_gated="{{ product.metafields.custom.gated | default: false }}">
</div>
<script>
  console.log("Product object:", {{ product.metafields.tokengating-example-app | json }});
  window.myAppGates = [
    {%- assign gates_metafield = product.metafields.tokengating-example-app | default: '[]' -%}
    {%- assign gates = gates_metafield | parse_json -%}
    {%- for gate in gates -%}
        {
          id: "{{ gate.gateConfigurationId }}",
          name: "{{ gate.name | escape }}",
          requirements: {{ gate.requirements | json }},
          reaction: {{ gate.reaction | json }}
        },
    {%- endfor -%}
  ];
</script>

<script async type="module" src="{{ "index.js" | asset_url }}"></script>
<link rel="stylesheet" href="{{ "index.css" | asset_url }}">

{% schema %}
  {
    "name": "Tokengate",
    "target": "section",
    "templates": ["product"],
    "settings": []
  }
{% endschema %}

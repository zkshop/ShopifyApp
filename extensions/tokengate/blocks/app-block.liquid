<div
  id="tokengating-example-app"
  data-product_id="{{ product.id }}"
  data-product_gated="{{ product.metafields.custom.gated | default: false }}">
</div>
<script>
  window.myAppGates = [
    {%- assign gates_metafield = product.metafields.custom.gates | default: '[]' -%}
    {%- assign gates = gates_metafield | parse_json -%}
    {%- for gate in gates -%}
      {%- if gate.configuration.handle == 'tokengating-example-app' -%}
        {
          id: "{{ gate.configuration.id }}",
          name: "{{ gate.configuration.name | escape }}",
          requirements: {{ gate.configuration.requirements | json }},
          reaction: {{ gate.configuration.reaction | json }}
        },
      {%- endif -%}
    {%- endfor -%}
  ];
</script>

<script async type="module" src="{{ "index.js" | asset_url }}"></script>
<link rel="stylesheet" href="{{ "index.css" | asset_url }}">

{% schema %}
  {
    "name": "Tokengate",
    "target": "section",
    "templates": ["product"],
    "settings": []
  }
{% endschema %}

<div
  id="tokengating-example-app"
  data-product_id="{{ product.id }}"
  data-product_gated="{{ product.metafields.tokengating-example-app.gate.gated | default: false }}">
</div>
{% assign productMetafields = product.metafields.tokengating-example-app %}
<script>
  var metafields = {{ productMetafields | json }}
  console.log('metafields: ', metafields)
  window.myAppGates = [
      {
        id: metafields.gate.gateConfigurationId,
        name: metafields.gate.name,
        requirements: metafields.gate.requirements,
        reaction: metafields.gate.reaction
      },
  ];
  document.addEventListener("DOMContentLoaded", function() {
    var tokengatingDiv = document.getElementById("tokengating-example-app");
    if (tokengatingDiv) {
      tokengatingDiv.setAttribute("data-product_gated", metafields.gate.gated);
    }
  });
  console.log('window.myAppGates: ',  window.myAppGates)
</script>

<script async type="module" src="{{ "index.js" | asset_url }}"></script>
<link rel="stylesheet" href="{{ "index.css" | asset_url }}">

{% schema %}
  {
    "name": "Tokengate",
    "target": "section",
    "templates": ["product"],
    "settings": []
  }
{% endschema %}

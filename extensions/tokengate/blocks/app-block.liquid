<div
  id="tokengating-example-app"
  data-product_id="{{ product.id }}"
  data-product_gated="{{ product.metafields.metafields.tokengating-example-app.gated | default: false }}">
</div>
<script>
  console.log("Product object:", {{ product.metafields.tokengating-example-app | json }});
  window.myAppGates = [
      {
        id: "{{ product.metafields.tokengating-example-app.gate.gateConfigurationId }}",
        name: "{{ product.metafields.tokengating-example-appgate.name | escape }}",
        requirements: {{ product.metafields.tokengating-example-appgate.requirements | json }},
        reaction: {{ product.metafields.tokengating-example-appgate.reaction | json }}
      },
  ];
</script>

<script async type="module" src="{{ "index.js" | asset_url }}"></script>
<link rel="stylesheet" href="{{ "index.css" | asset_url }}">

{% schema %}
  {
    "name": "Tokengate",
    "target": "section",
    "templates": ["product"],
    "settings": []
  }
{% endschema %}
